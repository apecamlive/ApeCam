# ---- Local development -------------------------------------------------------------
# Database: either Docker (`docker compose up -d`) or PGlite without Docker (`pnpm --filter @apecam/db dev`)
DATABASE_URL=postgres://apecam:apecam@localhost:5432/apecam
# DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres   # PGlite dev server
REDIS_URL=redis://localhost:6379   # optional locally; required on Railway (BullMQ, nonces, caches)

APP_ORIGIN=http://localhost:3000   # exact origin users load; SIWE/SIWS messages and CSRF checks use it
# Generate with: pnpm --filter @apecam/web gen:session-key
SESSION_JWT_PRIVATE_KEY=
SESSION_JWT_KID=

# Cloudflare Transform Rule adds header `x-apecam-origin: <secret>`; the origin rejects requests without it.
# Leave empty locally. /api/health stays open for Railway's health check.
CF_ORIGIN_SECRET=

# ---- On Railway these come from service references --------------------------------
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}

# ---- Chains (ADR 001, 005) ---------------------------------------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com   # Helius URL in production
SOLANA_RPC_FALLBACK=
RPC_ROBINHOOD_PRIMARY=https://rpc.mainnet.chain.robinhood.com   # Alchemy in production
RPC_ROBINHOOD_FALLBACK=
RPC_BASE_PRIMARY=
RPC_BASE_FALLBACK=
RPC_BSC_PRIMARY=
RPC_BSC_FALLBACK=

# ---- LiveKit (streaming is disabled until these are set) ---------------------------
LIVEKIT_URL=           # wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Cloudflare R2 (stream snapshots / thumbnails) ---------------------------------
R2_ENDPOINT=           # https://<account>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_BACKUP_BUCKET=      # PRIVATE bucket (no public access) for daily DB backups; lifecycle: delete after 30 days

# ---- Browser (baked in at build time: changing them needs a redeploy) --------------
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=   # enables WalletConnect / mobile QR in RainbowKit
NEXT_PUBLIC_SOLANA_RPC=                 # public/limited RPC for the wallet adapter, not the Helius key

# ---- Moderator alerts (auto-blur, severe reports) ---------------------------------
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# ---- $APECAM tracker + Stream to Earn payouts (owner provides, D17) ----------------
# Leave empty until $APECAM is deployed: /burn shows "coming soon" and payout batches are disabled.
APECAM_CONTRACT=
APECAM_DEPLOY_BLOCK=                 # block the contract was deployed in (backfill starts here)
APECAM_INITIAL_SUPPLY_RAW=           # optional, default 1e9 * 1e18
WALLET_CREATOR_FEE=
WALLET_OPERATIONS=
WALLET_BUYBACK=
WALLET_BURN=
WALLET_TREASURY=

# ---- Privy embedded wallets (D7; server side reads the wallet address) -------------
PRIVY_APP_ID=
PRIVY_APP_SECRET=
